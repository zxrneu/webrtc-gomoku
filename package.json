{
  "name": "webrtc-gomoku-monorepo",
  "version": "1.4.0",
  "private": true,
  "description": "WebRTC P2P 联机五子棋 (TypeScript + pnpm workspace + React + CSS Modules)",
  "scripts": {
    "dev": "pnpm --filter @webrtc-gomoku/web dev",
    "dev:server": "pnpm --filter @webrtc-gomoku/server dev",
    "build:core": "pnpm --filter @webrtc-gomoku/core build",
    "build:shared": "pnpm --filter @webrtc-gomoku/shared build",
    "build:web": "pnpm --filter @webrtc-gomoku/web build",
    "build:server": "pnpm --filter @webrtc-gomoku/server build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:solver": "cargo build --locked --release --manifest-path crates/gomoku-solver/Cargo.toml",
    "build": "pnpm run build:solver && pnpm run build:core && pnpm run build:shared && pnpm run build:web && pnpm run build:server",
    "start": "node apps/server/dist/server.js",
    "test:rust": "cargo test --locked --manifest-path crates/gomoku-solver/Cargo.toml",
    "test": "pnpm run test:rust && vitest run",
    "test:legacy": "node test/core.test.js",
    "test:qr": "node test/qr-scan.test.js",
    "test:e2e": "node test/mode-navigation.e2e.js && node test/e2e.js && node test/room-board.e2e.js && node test/ai-e2e.js && node test/chat-e2e.js && node test/media-real-p2p.e2e.js && node test/lobby-e2e.js && node test/lobby-pagination.e2e.js && node test/lobby-protocol.e2e.js && node test/lobby-edge.e2e.js && pnpm test:https",
    "ai:prove": "pnpm build:core && node scripts/ai-proof.mjs solve",
    "ai:verify": "pnpm build:core && node scripts/ai-proof.mjs verify",
    "ai:rust:prove": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- solve",
    "ai:rust:compile": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- compile",
    "ai:rust:import": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- import-fucusy",
    "ai:rust:work": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- work",
    "ai:rust:dfpn": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- dfpn",
    "ai:rust:resume": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- resume",
    "ai:rust:verify": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- verify",
    "ai:rust:move": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- move",
    "ai:rust:export": "cargo run --locked --release --manifest-path crates/gomoku-solver/Cargo.toml -- export",
    "ai:bench": "pnpm build:core && node scripts/ai-bench.mjs",
    "bench:differential": "pnpm build:core && node --import tsx scripts/ai-differential-bench.mjs",
    "test:https": "node test/https.e2e.js",
    "https:setup": "node scripts/setup-https.mjs",
    "start:https": "node scripts/start-https.mjs node",
    "start:https:rust": "node scripts/start-https.mjs rust"
  },
  "devDependencies": {
    "@vitest/ui": "3.2.7",
    "playwright": "^1.64.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
