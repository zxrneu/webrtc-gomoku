{
  "name": "webrtc-gomoku-monorepo",
  "version": "1.3.0",
  "private": true,
  "description": "WebRTC P2P 联机五子棋 (TypeScript + pnpm workspace + React + CSS Modules)",
  "scripts": {
    "dev": "pnpm --filter @webrtc-gomoku/web dev",
    "dev:server": "pnpm --filter @webrtc-gomoku/server dev",
    "build:core": "pnpm --filter @webrtc-gomoku/core build",
    "build:shared": "pnpm --filter @webrtc-gomoku/shared build",
    "build:web": "pnpm --filter @webrtc-gomoku/web build",
    "build:server": "pnpm --filter @webrtc-gomoku/server build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "pnpm run build:core && pnpm run build:shared && pnpm run build:web && pnpm run build:server",
    "start": "node apps/server/dist/server.js",
    "test": "vitest run",
    "test:legacy": "node test/core.test.js",
    "test:qr": "node test/qr-scan.test.js",
    "test:e2e": "node test/e2e.js && node test/ai-e2e.js && node test/chat-e2e.js && node test/media-real-p2p.e2e.js",
    "ai:prove": "pnpm build:core && node scripts/ai-proof.mjs solve",
    "ai:verify": "pnpm build:core && node scripts/ai-proof.mjs verify",
    "ai:bench": "pnpm build:core && node scripts/ai-bench.mjs",
    "bench:differential": "pnpm build:core && node --import tsx scripts/ai-differential-bench.mjs"
  },
  "devDependencies": {
    "@vitest/ui": "3.2.7",
    "playwright": "^1.64.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
