{
  "name": "@webrtc-gomoku/server",
  "version": "1.4.0",
  "description": "Signaling and static file server for WebRTC Gomoku",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --target node18",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@webrtc-gomoku/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
