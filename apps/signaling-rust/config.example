# gomoku-signaling 配置参考（带注释版）
# ============================================================================
# 本文件与 config.example.toml 内容等价，仅增加逐项说明，便于运维阅读。
# 复制为 config.toml 后按需修改：cp config.example config.toml
#
# 合并优先级（后者覆盖前者）：
#   1. 内置默认值（本文件所列）
#   2. config.toml（路径可用 GOMOKU_CONFIG_FILE 指定）
#   3. 环境变量 GOMOKU_*（数组用逗号分隔）
#
# 校验：非法配置启动即失败（fail-fast），并给出字段级错误。
# 脱敏：turn_credential / admin.token / redis.url 内嵌密码在日志与
#       /admin/config 中一律输出 ***。
# ============================================================================

# ---------------------------------------------------------------------------
# [server] 监听与静态托管
# ---------------------------------------------------------------------------
[server]
# 监听地址；容器内一般为 0.0.0.0
host = "0.0.0.0"
# 监听端口（1..=65535）
port = 3000
# 静态目录；缺失时按 [配置值, packages/web/dist, dist, public] 顺序回退探测
public_dir = "public"
# WS Origin 白名单；空 = 不校验（保持 v1 行为）。配置后仅白名单内 Origin 可升级。
allowed_ws_origins = []
# per-IP 限流的客户端 IP 来源开关。
#   false（默认）：取 socket 对端地址（安全，XFF 不可伪造）
#   true：取 X-Forwarded-For 最左地址（仅前置可信 LB 场景开启）
trust_proxy_headers = false

# ---------------------------------------------------------------------------
# [timeouts] 超时（秒）
# ---------------------------------------------------------------------------
[timeouts]
# WS ping 周期
ws_ping_interval_secs = 30
# 无 pong 判定假死并断开（对齐 v1 两个 ping 周期）
ws_idle_timeout_secs = 60
# WS 握手超时
ws_handshake_timeout_secs = 10
# 优雅关闭排空时长
shutdown_drain_secs = 15

# ---------------------------------------------------------------------------
# [limits] 并发上限
# ---------------------------------------------------------------------------
[limits]
# 全节点 WS 长连接上限，超出拒绝新连接（503）
max_connections = 100000
# 单 IP 连接上限
max_connections_per_ip = 10
# 房间数上限（1v1 下 10 万连接 ≈ 5 万房间）
max_rooms = 50000
# 单消息大小上限（字节，64KB 覆盖 SDP/ICE）
max_message_bytes = 65536
# 连接级出站有界队列容量；满则断开慢客户端（禁止无限缓冲）
broadcast_queue_capacity = 256

# ---------------------------------------------------------------------------
# [redis] 跨节点中转
# ---------------------------------------------------------------------------
[redis]
# 跨节点中转总开关（环境变量 GOMOKU_REDIS_ENABLED）。
#   true（默认）：启动后台连接任务；Redis 不可达时按 1s→30s 退避重连，
#                 期间本地建房/加入/信令不受影响，仅跨节点功能暂停。
#   false：单节点部署推荐。完全不启动后台任务——无重连开销、
#          无每 30s 一条的 warn 日志，跨节点功能关闭，本地功能不变。
# 注意：本项需重启生效（热重载会报 restart_required）。
enabled = true
# 连接串（可含认证：redis://user:pass@host:6379）。
# 留空（GOMOKU_REDIS_URL=""）等同 enabled = false。
url = "redis://127.0.0.1:6379"
# 发布者连接池大小
pool_size = 16
# pub/sub channel 与 key 前缀
channel_prefix = "gomoku:signal"
# 连接超时（毫秒）
connect_timeout_ms = 5000
# 房间注册 TTL（秒），建房/加入刷新，防幽灵房间
room_ttl_secs = 3600

# ---------------------------------------------------------------------------
# [cluster] 集群
# ---------------------------------------------------------------------------
[cluster]
# 节点标识，进日志与跨节点消息；缺省为 <hostname>-<rand8>
node_id = "node-dev-0001"
# 预留：节点清单（供未来直连优化/管理面展示）
nodes = []

# ---------------------------------------------------------------------------
# [cors] 跨域
# ---------------------------------------------------------------------------
[cors]
# 允许的来源白名单；空 = 仅同源，不输出 CORS 头
origins = []

# ---------------------------------------------------------------------------
# [logging] 日志
# ---------------------------------------------------------------------------
[logging]
# trace / debug / info / warn / error（支持热改）
level = "info"
# text / json
format = "text"

# ---------------------------------------------------------------------------
# [ice] 下发给客户端的 STUN/TURN
# ---------------------------------------------------------------------------
[ice]
stun_servers = [
  "stun:stun.qq.com:3478",
  "stun:stun.aliyun.com:3478",
  "stun:stun1.l.google.com:19302",
  "stun:stun2.l.google.com:19302",
]
# TURN 地址；空 = 不下发 TURN 段
turn_url = ""
turn_username = ""
# TURN 凭证（脱敏存储与展示）
turn_credential = ""
# 是否明文下发 TURN credential（false 时 /config 仅返回 STUN 段）
turn_credential_exposed = true

# ---------------------------------------------------------------------------
# [admin] 管理面
# ---------------------------------------------------------------------------
[admin]
# 管理 API 令牌；空 = 管理面整体禁用（/admin/* 返回 404）
token = ""
