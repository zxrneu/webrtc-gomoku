[Unit]
Description=Gomoku Rust signaling and HTTPS
After=network.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart="@APP_DIR@/gomoku-signaling"
Environment="GOMOKU_HOST=0.0.0.0"
Environment="GOMOKU_PORT=443"
Environment="GOMOKU_PUBLIC_DIR=public"
Environment="GOMOKU_REDIS_ENABLED=false"
Environment="TLS_CERT_FILE=.certs/current/fullchain.pem"
Environment="TLS_KEY_FILE=.certs/current/privkey.pem"
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
